# Copy the values you need into .env.local (never commit .env.local).

REACT_APP_YOUTUBE_API_KEY=

# Firebase console -> Project settings -> Your apps -> Web app -> firebaseConfig
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=spotifyclone128.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=spotifyclone128
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Realtime Database URL (Listen Together), e.g. https://<project>-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_DATABASE_URL=
# NVIDIA AI (build.nvidia.com). NO REACT_APP_ prefix: stays on the server, never in the bundle.
# Used by the dev proxy (src/setupProxy.js) during npm start.
NVIDIA_KEY=
# Production: URL of a proxy that adds the key (e.g. a Cloudflare Worker). Default /api/nvidia.
REACT_APP_NVIDIA_PROXY_URL=
# Optional: limit/reorder the AI models (ids from src/services/aiModels.js), comma-separated
REACT_APP_AI_MODELS=
# Optional Gemini model for the AI playlist maker
REACT_APP_GEMINI_MODEL=gemini-3.8-flash
# App Check (reCAPTCHA v3 site key). Optional on localhost: a fixed debug token.
REACT_APP_RECAPTCHA_SITE_KEY=
REACT_APP_APPCHECK_DEBUG_TOKEN=
# Or a reCAPTCHA Enterprise key (use one or the other)
REACT_APP_RECAPTCHA_ENTERPRISE_KEY=
# AI pipeline inspector on /ai (prompts, raw replies, timings). Default: on under
# `npm start`, off in builds. Never enable in a public production build.
REACT_APP_AI_DEBUG=
